# 由 install.sh 自动生成到 /etc/nodelite-auto-deploy.env（权限 0600），一般无需手动编辑。
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=replace-with-at-least-14-random-characters
WEB_SESSION_SECRET=replace-with-at-least-32-high-entropy-characters
# 默认只监听本机，通过 SSH 隧道访问。改成非回环地址必须同时设置 WEB_ALLOW_PUBLIC_LISTEN=1。
WEB_LISTEN_HOST=127.0.0.1
WEB_LISTEN_PORT=8780
WEB_ALLOW_PUBLIC_LISTEN=0
# 放在 HTTPS 反代之后时设为 1
WEB_COOKIE_SECURE=0
MAX_CONCURRENT_TASKS=2
TASK_RESULT_TTL_SECONDS=900
WEB_SESSION_TTL_SECONDS=28800
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300
TASK_RATE_LIMIT=5
TASK_RATE_WINDOW_SECONDS=300
SSH_CONNECT_TIMEOUT=15
INSTALL_TIMEOUT_SECONDS=1500
# 1 = 允许内网/私有地址目标（回环地址始终禁止）
ALLOW_PRIVATE_TARGETS=0
# 可选目标白名单，例如：203.0.113.0/24,2001:db8:1234::/48
TARGET_ALLOWLIST_CIDRS=
